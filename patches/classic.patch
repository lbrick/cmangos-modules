+// lbrick/cmangos-dev#68: a bot read a freed creature from its own attacker set. Debug.AttackerTripwire
+// (default off; env Mangosd_Debug_AttackerTripwire=1) logs each attacker-set write made from another
+// map's update thread or across maps, and each unit deleted while still in an attacker set, with a
+// backtrace, so the free path shows in the server log before the read that crashes.
+thread_local uint32 t_attackerTripwireMapId = UINT32_MAX;
+thread_local uint32 t_attackerTripwireInstanceId = 0;
+
+AttackerTripwireMapScope::AttackerTripwireMapScope(uint32 mapId, uint32 instanceId)
+{
+    t_attackerTripwireMapId = mapId;
+    t_attackerTripwireInstanceId = instanceId;
+}
+
+AttackerTripwireMapScope::~AttackerTripwireMapScope()
+{
+    t_attackerTripwireMapId = UINT32_MAX;
+    t_attackerTripwireInstanceId = 0;
+}
+
+static bool AttackerTripwireEnabled()
+{
+    static bool const enabled = sConfig.GetBoolDefault("Debug.AttackerTripwire", false);
+    return enabled;
+}
+
+static std::string AttackerTripwireUnit(Unit const* unit)
+{
+    std::ostringstream out;
+    out << unit->GetObjectGuid().GetString() << " entry=" << unit->GetEntry() << " map=" << unit->GetMapId()
+        << " instance=" << unit->GetInstanceId() << " inWorld=" << (unit->IsInWorld() ? 1 : 0);
+    return out.str();
+}
+
+static void AttackerTripwireReport(char const* event, std::string const& detail)
+{
+    // At most 200 lines a process, so a frequent path cannot flood the log.
+    static std::atomic<uint32> reports{0};
+    uint32 const n = ++reports;
+    if (n > 200)
+        return;
+
+    std::ostringstream out;
+    out << "[Attacker tripwire] event=" << event << " n=" << n << " thread_map=";
+    if (t_attackerTripwireMapId == UINT32_MAX)
+        out << "none";
+    else
+        out << t_attackerTripwireMapId << ":" << t_attackerTripwireInstanceId;
+    out << " " << detail;
+#ifndef _WIN32
+    void* frames[24];
+    int const count = backtrace(frames, 24);
+    char** symbols = backtrace_symbols(frames, count);
+    out << " stack=";
+    for (int i = 1; i < count; ++i)
+        out << (symbols ? symbols[i] : "?") << (i + 1 < count ? " | " : "");
+    free(symbols);
+#endif
+    sLog.outString("%s", out.str().c_str());
+}
+
+void Unit::AttackerTripwire(Unit const* attacker, char const* event) const
+{
+    if (!AttackerTripwireEnabled())
+        return;
+
+    bool const crossMap = attacker->GetMapId() != GetMapId() || attacker->GetInstanceId() != GetInstanceId();
+    // Map update threads own their map's units; the world thread (no map scope) is not checked.
+    bool const foreignThread = t_attackerTripwireMapId != UINT32_MAX &&
+        (GetMapId() != t_attackerTripwireMapId || GetInstanceId() != t_attackerTripwireInstanceId);
+    if (!crossMap && !foreignThread)
+        return;
+
+    AttackerTripwireReport(event, std::string(crossMap ? "cross_map=1" : "cross_map=0") +
+        (foreignThread ? " foreign_thread=1" : " foreign_thread=0") +
+        " victim=" + AttackerTripwireUnit(this) + " attacker=" + AttackerTripwireUnit(attacker));
+}
+
