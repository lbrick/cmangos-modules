+        if (m_attacking) // the victim may already be freed: log its address, never read through it
+        {
+            std::ostringstream victim;
+            victim << " victim_ptr=" << static_cast<void const*>(m_attacking);
+            detail += victim.str();
+        }
+        AttackerTripwireReport("deleted_in_attacker_set", detail);
+    }
